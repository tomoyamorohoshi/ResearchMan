#!/bin/sh
# 監査ゲート：Cannes 2026網羅・サムネイル健全性・Technology整合に問題があればpushを中止。
# このファイルはリポジトリの原本。実際に効くのは .git/hooks/pre-push（git管理外）なので、
# 変更したら必ず反映すること: cp scripts/hooks/pre-push .git/hooks/pre-push
echo "[pre-push] Running Cannes 2026 coverage audit..."
node scripts/audit-cannes.mjs || { echo "[pre-push] 監査失敗：抜け漏れがあります。push を中止しました。"; exit 1; }
echo "[pre-push] Running thumbnail health audit..."
node scripts/audit-thumbnails.mjs || { echo "[pre-push] サムネ監査失敗：プレースホルダ/重複があります。push を中止しました。"; exit 1; }
echo "[pre-push] Running Technology integrity audit..."
node scripts/audit-tech.mjs || { echo "[pre-push] Technology監査失敗：フィールド/語彙/サムネイルに問題があります。push を中止しました。"; exit 1; }
# 鮮度検査: manifest(コミット対象)==HEADのideas.json、かつ（ideas.json/manifestを変えるpushでは）ローカルの
# idea-layouts.json本体(git非追跡)==manifest。本体がBlobへ送られる前提の保証
echo "[pre-push] Running idea-layouts freshness check..."
node scripts/check-idea-layouts-freshness.mjs || { echo "[pre-push] idea-layouts鮮度検査失敗：push を中止しました。"; exit 1; }
# 巨大データJSON(cases/ideas/idea-layouts)をVercel Blobへ同期（Deployment Storage肥大の対策）。
# 全pushの経路（日次ジョブ・Studio・手動）を1か所で拾うためここに置く。変更が無ければハッシュ比較のみで即終了。
# 失敗してもpushは止めない（監査ではなく配信の同期。失敗時は次回push時に再試行される）。
echo "[pre-push] Syncing public data to Vercel Blob..."
node scripts/upload-public-data.mjs || echo "[pre-push] 警告：Blob同期に失敗しました（pushは続行。次回pushで再試行されます）。"
