push([1,"4:E{\"digest\":\"NEXT_HTTP_ERROR_FALLBACK;404\"}\n"])</script><script>self.__next_f.push([1,"10:Tf92,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://openchatcut.com/#organization\",\"name\":\"OpenChatCut\",\"url\":\"https://openchatcut.com\",\"logo\":\"https://openchatcut.com/openchatcut-icon.png\",\"sameAs\":[\"https://github.com/0xsline/OpenChatCut\",\"https://discord.gg/JActyWMjms\"]},{\"@type\":\"WebSite\",\"@id\":\"https://openchatcut.com/#website\",\"name\":\"OpenChatCut\",\"url\":\"https://openchatcut.com\",\"description\":\"OpenChatCut is an open-source ChatCut alternative: local-first AI video editing where Codex, Claude, and MCP agents work on a real multitrack timeline. Free, editable exports, AGPL.\",\"inLanguage\":\"en-US\",\"publisher\":{\"@id\":\"https://openchatcut.com/#organization\"}},{\"@type\":\"SoftwareApplication\",\"@id\":\"https://openchatcut.com/#software\",\"name\":\"OpenChatCut\",\"url\":\"https://openchatcut.com/opengraph-image\",\"description\":\"OpenChatCut is an open-source ChatCut alternative: local-first AI video editing where Codex, Claude, and MCP agents work on a real multitrack timeline. Free, editable exports, AGPL.\",\"applicationCategory\":\"MultimediaApplication\",\"operatingSystem\":\"Web, macOS, Windows\",\"image\":\"https://openchatcut.com/site/editor-overview.png\",\"screenshot\":[\"https://openchatcut.com/site/editor-overview.png\",\"https://openchatcut.com/site/agent-transitions.png\",\"https://openchatcut.com/site/motion-graphics.png\"],\"isAccessibleForFree\":true,\"downloadUrl\":\"https://openchatcut.com/download\",\"installUrl\":\"https://openchatcut.com/download\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\",\"url\":\"https://openchatcut.com/download\"},\"license\":\"https://www.gnu.org/licenses/agpl-3.0.html\",\"author\":{\"@id\":\"https://openchatcut.com/#organization\"}},{\"@type\":\"FAQPage\",\"@id\":\"https://openchatcut.com/opengraph-image#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is OpenChatCut free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. OpenChatCut is open source. Download the desktop builds or run from source — there is no paid pricing wall on this site.\"}},{\"@type\":\"Question\",\"name\":\"Where do projects and media live?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Local-first by default. Projects and media stay on your machine. Online models, transcription, and remote storage are optional when you configure them.\"}},{\"@type\":\"Question\",\"name\":\"How is this different from AI video generators?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Generators return a finished file that is hard to revise. OpenChatCut puts an agent on a real multitrack timeline — clips, captions, audio, and history stay editable and undoable.\"}},{\"@type\":\"Question\",\"name\":\"Is OpenChatCut an open-source ChatCut alternative?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. OpenChatCut is an independent open-source ChatCut-style AI video editor: local-first multitrack timeline, MCP for Codex and Claude, AGPL licensed. It is not affiliated with the commercial ChatCut product.\"}},{\"@type\":\"Question\",\"name\":\"Which AI models does it support?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The built-in agent supports multiple providers and OpenAI-compatible APIs. External agents such as Codex and Claude Code can drive the same project through MCP.\"}},{\"@type\":\"Question\",\"name\":\"What is MCP used for?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"MCP exposes structured project tools so external agents can read the timeline and apply edits through the same editor command path as the in-app agent.\"}},{\"@type\":\"Question\",\"name\":\"Why does macOS warn that the app is unsigned?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Early builds may not be signed or notarized yet. Download only from official GitHub Releases, then allow the app in System Settings → Privacy \u0026 Security, or Control-click → Open.\"}},{\"@type\":\"Question\",\"name\":\"What can I export?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Export masters, audio, captions, and project formats such as FCPXML depending on the current release. Check the download page and docs for the latest capabilities.\"}}]}]}"])</script><script>self.__next_f.push([1,"5:[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-[#080808] text-white\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$10\"}}],\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\"]}]\n"])</script><script>self.__next_f.push([1,"11:[\"$\",\"div\",null,{\"className\":\"paper-grain\",\"aria-hidden\":true}]\n14:[\"$\",\"main\",null,{\"children\":[\"$L16\",\"$L17\",\"$L18\",\"$L19\"]}]\n"])</script><script>self.__next_f.push([1,"b:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n"])</script><script>self.__next_f.push([1,"1a:I[22034,[\"/_next/static/chunks/15j.ue8f5phhl.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/0r_tz8iyy3ggz.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/0zij0ty27zcje.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/0ipajq82au~u7.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/0_96kr266w0x1.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/0729.-vxpbh-d.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/117u0bfmqmckf.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/0_sk9_kxfa-4d.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/17-l68-gsxx3~.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/0f6mkiv.rf95h.js?dpl=dpl_C4s25g5f52mW7vapP8GP1joKHSi5\",\"/_next/static/chunks/0y83u_bi3osng.js