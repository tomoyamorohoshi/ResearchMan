<style id="wp-custom-css">.single-post .post_item_single > .post_featured, .single-post .post_header + .post_featured,
.single-post .entry-content > .post_featured:first-child{display:none !important;}
.single-post .related_posts .post_featured, .single-post .related_wrap .post_featured, .single-post .related_posts_item .post_featured, .single-post .related_posts img, .single-post .related_wrap img{display:block !important;visibility:visible !important;opacity:1 !important;}
.single-post .post_content > iframe, .single-post .entry-content > iframe, .single-post .post_content > p > iframe, .single-post .entry-content > p > iframe{width:100% !important;max-width:100% !important;aspect-ratio:16 / 9 !important;height:auto !important;min-height:320px !important;display:block !important;margin:25px auto !important;border:none !important;clear:both !important;}
.single-post figure.wp-block-embed, .single-post .wp-block-embed, .single-post figure.wp-block-image, .single-post .wp-block-image{margin-top:25px !important;margin-bottom:25px !important;clear:both !important;}
.single-post figure.wp-block-embed + h2,
.single-post figure.wp-block-embed + h3,
.single-post figure.wp-block-embed + h4,
.single-post .wp-block-image + h2,
.single-post .wp-block-image + h3{margin-top:25px !important;}
.home .page_content_wrap, .home .content_wrap, .home .elementor-section-wrap, .page-template-elementor_header_footer .page_content_wrap{width:100% !important;max-width:100% !important;padding-left:0 !important;padding-right:0 !important;}
@media(max-width:767px){
.elementor-element-4e3ef3e, .elementor-element-f71ebd9{transform:none !important;}
}
@media(max-width:767px){
html, body{width:100%;max-width:100%;overflow-x:hidden !important;}
.home .page_content_wrap, .home .content_wrap,
.home .elementor-section-wrap{width:100% !important;max-width:100% !important;overflow-x:hidden !important;}
.home .elementor, .home .elementor-section,
.home .elementor-container, .home .e-con,
.home .e-con-inner{max-width:100% !important;min-width:0 !important;box-sizing:border-box !important;}
.home .e-con-inner{width:100% !important;}
.home img, .home video,
.home iframe{max-width:100%;box-sizing:border-box;}
}
.trx-addons-posts-item-thumbnail{aspect-ratio:16 / 9;overflow:hidden;display:flex;align-items:center;justify-content:center;}
.trx-addons-posts-item-thumbnail img{width:100%;height:100%;object-fit:contain;display:block;}</style>
